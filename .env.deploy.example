COMPOSE_PROJECT_NAME=validade-production

APP_VERSION=latest
IMAGE_PULL_POLICY=always

POSTGRES_DB=validade_db
POSTGRES_USER=validade
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@validade.local
ADMIN_LOGIN=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

JWT_ACCESS_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN_SECONDS=900

API_BIND_ADDRESS=127.0.0.1
API_PORT=3001

WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=3100