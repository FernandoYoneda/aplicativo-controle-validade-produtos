generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STORE_USER

  @@map("user_role")
}

enum ProductLotWriteOffReason {
  SOLD
  EXPIRED
  DISCARDED

  @@map("product_lot_write_off_reason")
}

enum ExpirationEmailNotificationType {
  EXPIRATION_NEXT_30_DAYS
  EXPIRATION_EXPIRED
  WRITE_OFF_SOLD
  WRITE_OFF_EXPIRED
  WRITE_OFF_DISCARDED

  @@map("expiration_email_notification_type")
}

enum ExpirationEmailDeliveryStatus {
  PENDING
  SENT
  FAILED

  @@map("expiration_email_delivery_status")
}

enum ExpirationAlertType {
  UPCOMING
  EXPIRED

  @@map("expiration_alert_type")
}

model Store {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(120)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users    User[]
  products StoreProduct[]

  @@map("stores")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(120)
  email        String    @unique @db.VarChar(255)
  login        String    @unique @db.VarChar(80)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole  @default(STORE_USER)
  storeId      String?   @map("store_id") @db.Uuid
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  store               Store?               @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  productLotWriteOffs ProductLotWriteOff[]
  expirationAlertAcknowledgements ExpirationAlertAcknowledgement[]

  @@index([storeId])
  @@index([role])
  @@map("users")
}

model Product {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(40)
  barcode   String?  @unique @db.VarChar(32)
  name      String   @db.VarChar(160)
  brand     String?  @db.VarChar(120)
  category  String?  @db.VarChar(120)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  stores StoreProduct[]

  @@index([name])
  @@index([isActive])
  @@map("products")
}

model StoreProduct {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  store   Store        @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lots    ProductLot[]

  @@unique([storeId, productId])
  @@index([productId])
  @@index([storeId, isActive])
  @@map("store_products")
}

model ProductLot {
  id             String   @id @default(uuid()) @db.Uuid
  storeProductId String   @map("store_product_id") @db.Uuid
  batchNumber    String?  @map("batch_number") @db.VarChar(80)
  expirationDate DateTime @map("expiration_date") @db.Date
  quantity       Int      @default(1)
  notes          String?  @db.VarChar(500)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  storeProduct StoreProduct         @relation(fields: [storeProductId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  writeOffs    ProductLotWriteOff[]
  emailDeliveries ExpirationEmailDelivery[]
  alertAcknowledgements ExpirationAlertAcknowledgement[]

  @@index([storeProductId, expirationDate])
  @@index([expirationDate])
  @@index([isActive])
  @@map("product_lots")
}

model ProductLotWriteOff {
  id                String                   @id @default(uuid()) @db.Uuid
  productLotId      String                   @map("product_lot_id") @db.Uuid
  performedByUserId String                   @map("performed_by_user_id") @db.Uuid
  reason            ProductLotWriteOffReason
  quantity          Int
  previousQuantity  Int                      @map("previous_quantity")
  remainingQuantity Int                      @map("remaining_quantity")
  notes             String?                  @db.VarChar(500)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  productLot  ProductLot @relation(fields: [productLotId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  performedBy User       @relation(fields: [performedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  emailDeliveries ExpirationEmailDelivery[]

  @@index([productLotId, createdAt])
  @@index([performedByUserId, createdAt])
  @@index([reason, createdAt])
  @@map("product_lot_write_offs")
}

model ExpirationEmailDelivery {
  id               String                          @id @default(uuid()) @db.Uuid
  notificationType ExpirationEmailNotificationType @map("notification_type")
  status           ExpirationEmailDeliveryStatus   @default(PENDING)
  fingerprint      String                          @unique @db.VarChar(255)
  recipientName    String?                         @map("recipient_name") @db.VarChar(120)
  recipientEmail   String                          @map("recipient_email") @db.VarChar(255)
  subject          String                          @db.VarChar(255)
  errorMessage     String?                         @map("error_message") @db.VarChar(1000)
  productLotId     String?                         @map("product_lot_id") @db.Uuid
  writeOffId       String?                         @map("write_off_id") @db.Uuid
  sentAt           DateTime?                       @map("sent_at") @db.Timestamptz(3)
  createdAt        DateTime                        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(3)

  productLot ProductLot?         @relation(fields: [productLotId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  writeOff   ProductLotWriteOff? @relation(fields: [writeOffId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([notificationType, status, createdAt])
  @@index([productLotId, createdAt])
  @@index([writeOffId, createdAt])
  @@map("expiration_email_deliveries")
}

model ExpirationAlertAcknowledgement {
  id             String              @id @default(uuid()) @db.Uuid
  productLotId   String              @map("product_lot_id") @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  alertType      ExpirationAlertType @map("alert_type")
  acknowledgedAt DateTime            @default(now()) @map("acknowledged_at") @db.Timestamptz(3)

  productLot ProductLot @relation(fields: [productLotId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([productLotId, userId, alertType])
  @@index([productLotId, alertType, acknowledgedAt])
  @@index([userId, acknowledgedAt])
  @@map("expiration_alert_acknowledgements")
}
